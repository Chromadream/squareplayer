{
  "name": "squareplayer",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "clean:android": "cd android && JAVA_HOME=/usr/lib/jvm/java-17-openjdk ./gradlew clean",
    "build:apk": "cd android && JAVA_HOME=/usr/lib/jvm/java-17-openjdk ./gradlew assembleDebug",
    "build:android": "cd android && JAVA_HOME=/usr/lib/jvm/java-17-openjdk ./gradlew assembleDebug && adb install -r app/build/outputs/apk/debug/app-debug.apk",
    "build:apk:release": "cd android && JAVA_HOME=/usr/lib/jvm/java-17-openjdk ./gradlew assembleRelease",
    "build:android:release": "cd android && JAVA_HOME=/usr/lib/jvm/java-17-openjdk ./gradlew assembleRelease && adb install -r app/build/outputs/apk/release/app-arm64-v8a-release.apk"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^15.2.5",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-keyevent": "^0.3.2",
    "react-native-saf-x": "^2.2.3",
    "react-native-track-player": "5.0.0-alpha0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
